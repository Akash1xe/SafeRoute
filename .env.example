NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000/api/v1/realtime
DATABASE_URL=postgresql://saferoute:saferoute@localhost:5432/saferoute
REDIS_URL=redis://localhost:6379
ROUTE_CACHE_TTL_SECONDS=120
INCIDENT_MAINTENANCE_INTERVAL_MS=300000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
REQUEST_BODY_LIMIT=64kb
HTTP_REQUEST_TIMEOUT_MS=15000
SLOW_REQUEST_THRESHOLD_MS=750
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
POSTGRES_POOL_MAX=20
POSTGRES_STATEMENT_TIMEOUT_MS=10000
WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_IP=10
WS_MAX_PAYLOAD_BYTES=4096
WS_MAX_BUFFERED_BYTES=1048576
METRICS_TOKEN=replace-with-at-least-32-random-characters
TRUST_PROXY=false
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
